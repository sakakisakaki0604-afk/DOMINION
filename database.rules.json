{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",
          "players": {
            "$uid": {
              ".write": "auth != null && $uid === auth.uid && root.child('rooms').child($room).child('meta').child('status').val() === 'lobby'"
            }
          }
        },
        "public": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($room).child('meta').child('hostUid').val() === auth.uid"
        },
        "hands": {
          "$uid": {
            ".read": "auth != null && ($uid === auth.uid || root.child('rooms').child($room).child('meta').child('hostUid').val() === auth.uid)",
            ".write": "auth != null && root.child('rooms').child($room).child('meta').child('hostUid').val() === auth.uid"
          }
        },
        "actions": {
          ".read": "auth != null && root.child('rooms').child($room).child('meta').child('hostUid').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && $uid === auth.uid"
          }
        },
        "replay": {
          ".read": "auth != null && root.child('rooms').child($room).child('meta').child('hostUid').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($room).child('meta').child('hostUid').val() === auth.uid"
        },
        "secret": {
          ".read": "auth != null && root.child('rooms').child($room).child('meta').child('hostUid').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($room).child('meta').child('hostUid').val() === auth.uid"
        }
      }
    }
  }
}
